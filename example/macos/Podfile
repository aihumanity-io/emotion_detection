platform :osx, '11.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'
ENV['COPYFILE_DISABLE'] = '1'
ENV['COPY_EXTENDED_ATTRIBUTES_DISABLE'] = '1'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

pre_install do |_installer|
  pods_root = File.expand_path('Pods', __dir__)
  next unless Dir.exist?(pods_root)

  system('dot_clean', '-m', pods_root) if system('command', '-v', 'dot_clean', out: File::NULL, err: File::NULL)
  system('/usr/bin/find', pods_root, '-name', '._*', '-exec', '/bin/rm', '-f', '{}', '+')
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

def add_appledouble_cleanup_phase(target)
  return unless ['onnxruntime-c', 'onnxruntime-objc', 'ZIPFoundation'].include?(target.name)

  phase_name = 'Strip AppleDouble files'
  phase = target.shell_script_build_phases.find { |build_phase| build_phase.name == phase_name }
  phase ||= target.new_shell_script_build_phase(phase_name)
  phase.shell_script = <<-'SCRIPT'
export COPYFILE_DISABLE=1
export COPY_EXTENDED_ATTRIBUTES_DISABLE=1
if command -v dot_clean >/dev/null 2>&1; then
  for path in "${PODS_ROOT}" "${TARGET_BUILD_DIR}" "${BUILT_PRODUCTS_DIR}"; do
    [ -d "$path" ] && dot_clean -m "$path"
    [ -d "$path" ] && /usr/bin/find "$path" -name '._*' -exec /bin/rm -f {} +
  done
fi
SCRIPT
end

def add_appledouble_cleanup_phase_to_runner(user_target)
  return unless user_target.name == 'Runner'

  phase_name = 'Strip AppleDouble files'
  phase = user_target.shell_script_build_phases.find { |build_phase| build_phase.name == phase_name }
  phase ||= user_target.new_shell_script_build_phase(phase_name)
  phase.shell_script = <<-'SCRIPT'
export COPYFILE_DISABLE=1
export COPY_EXTENDED_ATTRIBUTES_DISABLE=1

app_path="${TARGET_BUILD_DIR}/${WRAPPER_NAME}"
if [ -d "$app_path" ]; then
  if command -v dot_clean >/dev/null 2>&1; then
    dot_clean -m "$app_path" || true
  fi
  /usr/bin/find "$app_path" -name '._*' -exec /bin/rm -f {} +
fi
SCRIPT
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    add_appledouble_cleanup_phase(target)
    # Keep all Pods aligned to macOS 11.0+ (required by onnxruntime-objc).
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '11.0'
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    user_project = aggregate_target.user_project
    next if user_project.nil?

    user_project.targets.each do |user_target|
      add_appledouble_cleanup_phase_to_runner(user_target)
    end

    user_project.save
  end
end
